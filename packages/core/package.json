{
  "name": "@eimzo/core",
  "version": "2.0.0",
  "description": "E-IMZO digital signature SDK - Core library",
  "author": "Sanjar Barakayev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanjarbarakayev/eimzo.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/sanjarbarakayev/eimzo#readme",
  "bugs": {
    "url": "https://github.com/sanjarbarakayev/eimzo/issues"
  },
  "keywords": [
    "e-imzo",
    "eimzo",
    "digital-signature",
    "electronic-signature",
    "eds",
    "pkcs7",
    "uzbekistan",
    "cryptography"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./crypto": {
      "import": {
        "types": "./dist/crypto.d.ts",
        "default": "./dist/crypto.js"
      },
      "require": {
        "types": "./dist/crypto.d.cts",
        "default": "./dist/crypto.cjs"
      }
    },
    "./i18n": {
      "import": {
        "types": "./dist/i18n.d.ts",
        "default": "./dist/i18n.js"
      },
      "require": {
        "types": "./dist/i18n.d.cts",
        "default": "./dist/i18n.cjs"
      }
    },
    "./mobile": {
      "import": {
        "types": "./dist/mobile.d.ts",
        "default": "./dist/mobile.js"
      },
      "require": {
        "types": "./dist/mobile.d.cts",
        "default": "./dist/mobile.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
