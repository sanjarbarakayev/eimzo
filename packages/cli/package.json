  "description": "CLI tool for E-IMZO SDK setup and diagnostics",
  "author": "Sanjar Barakayev",
  "license": "MIT",
  "homepage": "https://github.com/sanjarbarakayev/eimzo#readme",
  "repository": {
    "type": "git",
